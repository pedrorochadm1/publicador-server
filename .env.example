# ─── Credenciais do Instagram (Graph API) ───
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# ─── App do Facebook (para renovar o token automaticamente) ───
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Segredo do publicador (header X-API-Key para agendar) ───
PUBLICADOR_API_KEY=

# ─── URL pública HTTPS deste serviço (domínio do EasyPanel) ───
# O Instagram baixa a imagem por aqui. Sem isto, nada publica.
# Ex: https://publicador-pedrorochadm1.srv1274587.hstgr.cloud
PUBLIC_BASE_URL=

# ─── YouTube Data API (repost de Shorts) ───
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─── TikTok Content Posting API (repost) ───
# Este servidor é o ÚNICO dono dos tokens do TikTok (o refresh token rotaciona).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Deixe false até o app passar pela auditoria do TikTok. Antes disso, post sai privado.
TIKTOK_AUDITADO=false

# ─── Fuso e pasta de dados (volume persistente) ───
TZ=America/Sao_Paulo
DATA_DIR=/data

# ─── Automações de comentário → resposta + direct (painel insta.pedrorochadm1.com) ───
# Senha do painel (vazio = painel desligado)
INSTA_UI_PASSWORD=
# Token de verificação do webhook da Meta (valor livre, o mesmo no app do Facebook)
IG_WEBHOOK_VERIFY_TOKEN=
AUTOMACOES_ATIVAS=true
AUTOMACOES_POLL_SEGUNDOS=60
