# ─── Credenciais do Instagram (Graph API) ───
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# ─── App do Facebook (para renovar o token automaticamente) ───
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Segredo do publicador (header X-API-Key para agendar) ───
PUBLICADOR_API_KEY=

# ─── URL pública HTTPS deste serviço (domínio do EasyPanel) ───
# O Instagram baixa a imagem por aqui. Sem isto, nada publica.
# Ex: https://publicador-pedrorochadm1.srv1274587.hstgr.cloud
PUBLIC_BASE_URL=

# ─── Fuso e pasta de dados (volume persistente) ───
TZ=America/Sao_Paulo
DATA_DIR=/data
